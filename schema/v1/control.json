{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youtalk/adas-dashboard/schema/v1/control.json",
  "title": "control",
  "type": "object",
  "required": ["source", "type", "t_ms", "authority"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "type": { "const": "control" },
    "t_ms": { "type": "number" },
    "authority": { "enum": ["stack", "supervisor", "driver", "remote"] },
    "steer_rad": { "type": "number" },
    "accel_mps2": { "type": "number" }
  }
}
