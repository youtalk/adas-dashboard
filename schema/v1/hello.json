{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youtalk/adas-dashboard/schema/v1/hello.json",
  "title": "hello",
  "type": "object",
  "required": ["source", "type", "t_ms", "schema", "roles"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "type": { "const": "hello" },
    "t_ms": { "type": "number" },
    "schema": { "const": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["stack", "vehicle", "map", "supervisor"] }
    },
    "name": { "type": "string" },
    "device": { "type": "string" }
  }
}
