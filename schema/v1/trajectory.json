{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youtalk/adas-dashboard/schema/v1/trajectory.json",
  "title": "trajectory",
  "type": "object",
  "required": ["source", "type", "t_ms", "frame", "pts"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "type": { "const": "trajectory" },
    "t_ms": { "type": "number" },
    "frame": { "enum": ["ego", "map"] },
    "width_m": { "type": "number", "exclusiveMinimum": 0 },
    "pts": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
    },
    "behavior": { "type": "string" },
    "stop": {
      "type": "object",
      "required": ["x", "y", "reason"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "reason": { "type": "string" }
      }
    }
  }
}
